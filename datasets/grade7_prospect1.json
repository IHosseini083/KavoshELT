      "grammar_details": {
        "focus": "Telling the Time & Asking for Addresses and Phone Numbers",
        "rules": [
          {
            "structure": "Asking the time",
            "formula": "What time is it? / What's the time? -> It is + number + o'clock",
            "examples": [
              "What time is it? It is seven o'clock.",
              "It is eight thirty."
            ]
          },
          {
            "structure": "Asking for address and phone number",
            "formula": "What's your address? / What's your telephone number?",
            "examples": [
              "What is your address? It's 15 Azadi Street.",
              "What's your phone number? It's 3824567."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "Writing Addresses & Days of the Week",
        "rules": [
          "Days of the week are always capitalized (Saturday, Sunday, Monday, Tuesday, Wednesday, Thursday, Friday).",
          "In English addresses, the house number comes before the street name (15 Karimi Street)."
        ]
      },
      "vocab_development": {
        "topic": "Days of the Week & Clock Expressions",
        "rules": "Saturday, Sunday, Monday, Tuesday, Wednesday, Thursday, Friday. Time: morning, afternoon, evening, night, o'clock.",
        "examples": [
          "on Saturday",
          "at seven o'clock"
        ]
      },
      "see_also": {
        "topic": "Preposition 'at' with Time and Specific Address",
