      "title": "My House",
      "theme": "Rooms, furniture, household activities",
      "allowed_grammar": {
        "tenses": [
          "simple_present_be",
          "present_continuous_actions"
        ],
        "structures": [
          "there_is_there_are",
          "where_questions",
