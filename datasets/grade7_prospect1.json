      "lesson_num": 1,
      "title": "My Name",
      "theme": "Introductions, names, alphabet, greetings",
      "allowed_grammar": {
        "tenses": [
          "simple_present_be"
        ],
        "structures": [
          "subject_pronouns_i_you",
          "possessive_adjectives_my_your",
          "what_questions_be"
        ]
      },
      "forbidden_grammar": {
        "forbidden_tenses": [
          "simple_past",
          "future_will",
          "present_perfect",
          "past_progressive"
        ],
        "forbidden_structures": [
          "passive_voice",
          "conditionals",
          "relative_clauses"
        ]
      },
      "grammar_details": {
        "focus": "To Be (am, is, are) & Possessive Adjectives (my, your)",
        "rules": [
          {
            "structure": "What is your name?",
            "formula": "What + is + possessive adjective + name?",
            "examples": [
              "What's your name? My name is Ali.",
              "What is his name? His name is Reza."
            ]
          },
          {
            "structure": "To Be with Subject Pronouns",
            "formula": "I am / You are / He is / She is",
            "examples": [
              "I am fine, thank you.",
              "This is my friend, Nima."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "English Alphabet Letters (A-H) & Capitalization of Names",
        "rules": [
          "English words are written from left to right.",
          "The first letter of a name or surname is always capitalized (Ali Ahmadi).",
          "Names at the beginning of a sentence must start with a capital letter."
        ]
      },
      "vocab_development": {
        "topic": "Formal and Informal Greetings",
        "rules": "Good morning (before 12 PM), Good afternoon (12-5 PM), Good evening (after 5 PM), Hello, Hi.",
        "examples": [
          "Good morning, Mr. Karimi.",
          "Hi, Mina!"
        ]
      },
      "see_also": {
        "topic": "Alphabet Spelling & Letter Names",
        "rules": "Spell your first and last name clearly letter by letter: A-L-I."
      }
    },
    {
      "lesson_num": 2,
      "title": "My Classmates",
      "theme": "Classroom, friends, classmates, greetings",
      "allowed_grammar": {
        "tenses": [
          "simple_present_be"
        ],
        "structures": [
          "demonstratives_this_that",
          "who_questions_be",
          "plural_pronouns_we_they"
        ]
      },
      "forbidden_grammar": {
        "forbidden_tenses": [
          "simple_past",
          "future_will",
          "present_perfect"
        ],
        "forbidden_structures": [
          "passive_voice",
          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "Who is ...? & Demonstratives (This / That)",
        "rules": [
          {
            "structure": "Who is questions",
            "formula": "Who is + demonstrative / noun phrase?",
            "examples": [
              "Who is that boy? He is my classmate.",
              "Who is this girl? She is Sara."
            ]
          },
          {
            "structure": "Demonstratives (This / That)",
            "formula": "This (near) / That (far) + singular noun",
            "examples": [
              "This is our classroom.",
              "That is my desk."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "English Alphabet Letters (I-P) & Classroom Labels",
        "rules": [
          "Print uppercase and lowercase letters carefully on four-line notebooks.",
          "Place a full stop (period) at the end of affirmative sentences."
        ]
      },
      "vocab_development": {
        "topic": "Classroom Objects",
        "rules": "Names of tools used in class: pen, pencil, eraser, sharpener, ruler, desk, chair, notebook, board.",
        "examples": [
          "pencil and eraser",
          "ruler and sharpener"
        ]
      },
      "see_also": {
        "topic": "Pronunciation of Initial Consonants",
        "rules": "Clear articulation of /p/ vs /b/ and /t/ vs /d/."
      }
    },
    {
      "lesson_num": 3,
      "title": "My Age",
      "theme": "Numbers, age, months, birthdays",
      "allowed_grammar": {
        "tenses": [
          "simple_present_be"
        ],
        "structures": [
          "how_old_questions",
          "numbers_1_to_100",
          "preposition_in_for_months"
        ]
      },
      "forbidden_grammar": {
        "forbidden_tenses": [
          "simple_past",
          "future_will",
          "present_perfect"
        ],
        "forbidden_structures": [
          "passive_voice",
          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "How old are you? & Numbers 1–100",
        "rules": [
          {
            "structure": "Asking about age",
            "formula": "How old are you? / How old is he/she?",
            "examples": [
              "How old are you? I am twelve years old.",
              "How old is your brother? He is fifteen."
            ]
          },
          {
            "structure": "Months of the year with preposition in",
            "formula": "in + Month name",
            "examples": [
              "My birthday is in Mehr.",
              "School starts in autumn."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "English Alphabet Letters (Q-Z) & Writing Numbers",
        "rules": [
          "Months of the year always start with a capital letter (Farvardin, Mehr, Bahman).",
          "Writing English digits from left to right (1, 2, 3 ... 100)."
        ]
      },
      "vocab_development": {
        "topic": "Tens and Teens Numbers",
        "rules": "Notice the suffix -teen for 13-19 and -ty for tens (twenty, thirty, forty, fifty, sixty, seventy, eighty, ninety, hundred).",
        "examples": [
          "thirteen vs thirty",
          "fourteen vs forty"
        ]
      },
      "see_also": {
        "topic": "Number Stress",
        "rules": "Thir'teen vs 'Thirty; four'teen vs 'Forty."
      }
    },
    {
      "lesson_num": 4,
      "title": "My Family",
      "theme": "Family members, jobs, relationships",
      "allowed_grammar": {
        "tenses": [
          "simple_present_be"
        ],
        "structures": [
          "what_is_job_questions",
          "indefinite_articles_a_an",
          "he_she_is_profession"
        ]
      },
      "forbidden_grammar": {
        "forbidden_tenses": [
          "simple_past",
          "future_will",
          "present_perfect"
        ],
        "forbidden_structures": [
          "passive_voice",
          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "Asking About Professions (What's his/her job?) & Articles a/an",
        "rules": [
          {
            "structure": "Asking about jobs",
            "formula": "What is your/his/her job?",
            "examples": [
              "What's your father's job? He is a teacher.",
              "What's her job? She is a doctor."
            ]
          },
          {
            "structure": "Articles a vs an",
            "formula": "a + consonant sound (a pilot, a dentist)  |  an + vowel sound (an engineer, an uncle)",
            "examples": [
              "He is an English teacher.",
              "My uncle is a pilot."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "Writing Family Profiles & Job Descriptions",
        "rules": [
          "Capitalize the pronoun 'I' wherever it appears in a sentence.",
          "Use 'He is a ...' for male and 'She is a ...' for female jobs."
        ]
      },
      "vocab_development": {
        "topic": "Family Tree & Professions",
        "rules": "father, mother, brother, sister, grandfather, grandmother, uncle, aunt. Jobs: teacher, doctor, nurse, pilot, driver, firefighter, farmer, dentist.",
        "examples": [
          "father -> teacher",
          "mother -> nurse"
        ]
      },
      "see_also": {
        "topic": "Pronunciation of Possessive 's",
        "rules": "My father's job, Ali's brother."
      }
    },
