          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "Expressing Food Preferences (like, want) & Polite Requests",
        "rules": [
          {
            "structure": "What's your favorite food/drink?",
            "formula": "My favorite food is + noun  |  I like + food",
            "examples": [
              "What is your favorite food? I like rice and kebab.",
              "My favorite drink is water."
            ]
          },
          {
            "structure": "Polite offers with Would you like",
            "formula": "Would you like some + food/drink? -> Yes, please. / No, thanks.",
            "examples": [
              "Would you like some tea? Yes, please.",
              "Would you like an apple? No, thanks."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "Food Menus & Personal Preference Sentences",
        "rules": [
          "Separate items in a list with commas, using 'and' before the last item (rice, kebab, salad, and tea)."
        ]
      },
      "vocab_development": {
        "topic": "Meals, Food, and Traditional Drinks",
        "rules": "Meals: breakfast, lunch, dinner. Food: bread, cheese, milk, tea, rice, kebab, chicken, salad, cake, fruit, water.",
        "examples": [
          "rice and kebab",
          "bread and cheese"
        ]
      },
      "see_also": {
        "topic": "Polite Responses with 'please' and 'thank you'",
        "rules": "Always add 'please' for polite requests and 'thank you' for accepted offers."
      }
    }
