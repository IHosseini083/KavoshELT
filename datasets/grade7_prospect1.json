    {
      "lesson_num": 1,
      "section_type": "Conversation",
      "title": "Talking about Names",
      "content": "Teacher: 'Good morning, students.' Students: 'Good morning, teacher.' Teacher: 'I am your English teacher. My name is Ali Moradi.' Student: 'Excuse me, sir. What is your last name?' Teacher: 'Moradi. And what is your name?' Student: 'My name is Nima Ahmadi.' Teacher: 'Nice to meet you, Nima.'"
    },
    {
      "lesson_num": 1,
      "section_type": "Reading",
      "title": "Introducing Myself",
      "content": "Hello, my name is Ali. I am a student in Grade 7. My English teacher is Mr. Moradi. He is very kind. Welcome to our English class!"
    },
    {
      "lesson_num": 2,
      "section_type": "Conversation",
      "title": "Talking about Classmates",
      "content": "Reza: 'Who is that boy over there, Kian?' Kian: 'He is my friend and new classmate, Erfan.' Reza: 'Let's go and talk to him.' Kian: 'Hello Erfan, this is Reza.' Erfan: 'Nice to meet you, Reza. Welcome to our school.'"
    },
    {
      "lesson_num": 2,
      "section_type": "Reading",
      "title": "My Classroom Friends",
      "content": "This is our classroom. There are thirty students in our class. Reza and Kian are my best classmates. We help each other with our school lessons every day."
    },
    {
      "lesson_num": 3,
      "section_type": "Conversation",
      "title": "Talking about Age and Birthdays",
      "content": "Sara: 'How old are you, Maryam?' Maryam: 'I am twelve years old. And you?' Sara: 'I am twelve, too. When is your birthday?' Maryam: 'My birthday is in Mehr. And your birthday?' Sara: 'My birthday is in Bahman.'"
    },
    {
      "lesson_num": 3,
      "section_type": "Reading",
      "title": "Birthdays in Autumn",
      "content": "My name is Maryam and I am twelve years old. My birthday is in the month of Mehr. Mehr is the first month of autumn in Iran. We have a birthday party with my family."
    },
    {
      "lesson_num": 4,
      "section_type": "Conversation",
      "title": "Talking about Family Members and Jobs",
      "content": "Farhad: 'Is that your family photo, Omid?' Omid: 'Yes, this is my family.' Farhad: 'What is your father's job?' Omid: 'He is a school teacher.' Farhad: 'And what is your mother's job?' Omid: 'She is a nurse in a hospital.'"
    },
    {
      "lesson_num": 4,
      "section_type": "Reading",
      "title": "My Family",
      "content": "My name is Omid. I live with my family in Shiraz. My father is an English teacher and my mother is a kind nurse. My uncle is a pilot. We are a happy Iranian family."
    },
    {
      "lesson_num": 5,
      "section_type": "Conversation",
      "title": "Describing Appearance and Clothes",
      "content": "Zahra: 'Who is that tall girl over there?' Mina: 'Which one? What is she wearing?' Zahra: 'She is wearing a green scarf and a black chador.' Mina: 'That is our new teacher, Mrs. Tehrani. She is very kind and polite.'"
    },
    {
      "lesson_num": 5,
      "section_type": "Reading",
      "title": "My Classmate's Appearance",
      "content": "My friend Zahra is tall and has brown eyes. Today she is wearing a blue coat, a gray scarf, and black shoes. She looks neat in her school clothes."
    },
    {
      "lesson_num": 6,
      "section_type": "Conversation",
      "title": "Asking about Rooms in the House",
      "content": "Amir: 'Where are you, Hossein?' Hossein: 'I am in the kitchen.' Amir: 'What are you doing?' Hossein: 'I am drinking water. Where is father?' Amir: 'He is in the living room reading a book.'"
    },
    {
      "lesson_num": 6,
      "section_type": "Reading",
      "title": "Our Cozy House",
      "content": "We live in a nice house with a small garden. There is a living room, two bedrooms, and a clean kitchen. In the afternoon, mother cooks food in the kitchen and father rests in the living room."
    },
    {
      "lesson_num": 7,
      "section_type": "Conversation",
      "title": "Asking for Addresses and Time",
      "content": "Police officer: 'What is your address, boy?' Boy: 'My address is 24 Hafez Street.' Police officer: 'And what is your phone number?' Boy: 'It is 3224567.' Police officer: 'What time is it now?' Boy: 'It is four thirty in the afternoon.'"
    },
    {
      "lesson_num": 7,
      "section_type": "Reading",
      "title": "My School Address",
      "content": "My school is on Saadi Street, near the library. We attend school from Saturday to Wednesday. Classes start at eight in the morning and finish at one in the afternoon."
    },
    {
      "lesson_num": 8,
      "section_type": "Conversation",
      "title": "Ordering Food at an Iranian Restaurant",
      "content": "Waiter: 'Good afternoon. Can I help you?' Mehdi: 'Yes, please. What is your food today?' Waiter: 'We have delicious rice and kebab with salad.' Mehdi: 'Please bring me a bottle of water and a cup of tea, too.' Waiter: 'Certainly!'"
    },
    {
      "lesson_num": 8,
      "section_type": "Reading",
      "title": "My Favorite Meals",
      "content": "In Iran, people eat three meals every day: breakfast, lunch, and dinner. For breakfast, my family eats fresh bread, cheese, and hot tea. For lunch, my favorite food is rice with chicken and salad. It is healthy and delicious."
    }
