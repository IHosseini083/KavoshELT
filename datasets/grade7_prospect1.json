          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "Describing Appearance & Present Continuous with 'wearing'",
        "rules": [
          {
            "structure": "Asking about appearance",
            "formula": "What is he/she wearing? / What does he/she look like?",
            "examples": [
              "He is wearing a white shirt and black pants.",
              "Who is the tall boy with brown hair?"
            ]
          },
          {
            "structure": "Color + Clothing Noun",
            "formula": "Color adjective + Clothes noun",
            "examples": [
              "a blue jacket",
              "black shoes",
              "a green scarf"
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "Descriptive Paragraph on Appearance",
        "rules": [
          "Color adjectives sit directly before the clothes noun (a red shirt).",
          "Adjectives do not take plural -s in English (brown shoes, not browns shoes)."
        ]
      },
      "vocab_development": {
        "topic": "Colors & Clothes",
        "rules": "Colors: white, black, red, blue, green, yellow, brown, orange. Clothes: shirt, pants, jacket, shoes, scarf, chador, suit.",
        "examples": [
          "tall vs short",
          "black shoes",
          "white shirt"
        ]
      },
      "see_also": {
        "topic": "Compound Word Stress in Clothing",
        "rules": "Stress is on the first word in compound clothing: 'raincoat, 'sunglasses."
      }
    },
