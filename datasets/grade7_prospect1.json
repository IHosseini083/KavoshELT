        ]
      },
      "forbidden_grammar": {
        "forbidden_tenses": [
          "simple_past",
          "future_will",
          "present_perfect"
        ],
        "forbidden_structures": [
          "passive_voice",
          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "There is / There are & Present Continuous Actions",
        "rules": [
          {
            "structure": "There is vs There are",
            "formula": "There is + singular noun (There is a table in the kitchen)  |  There are + plural noun (There are two chairs)",
            "examples": [
              "There is a bed in my bedroom.",
              "There are books on the desk."
            ]
          },
          {
            "structure": "Present Continuous in House",
            "formula": "Subject + am/is/are + V-ing",
            "examples": [
              "Where is mother? She is cooking in the kitchen.",
              "Father is reading a newspaper in the living room."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "Prepositions of Place (in, on, under, next to)",
        "rules": [
          "Use 'in' for rooms (in the kitchen, in the bedroom).",
          "Use 'on' for surfaces (on the table, on the wall)."
        ]
      },
      "vocab_development": {
        "topic": "House Rooms & Common Furniture",
        "rules": "kitchen, bedroom, living room, bathroom, garage, garden, table, chair, bed, door, window.",
        "examples": [
          "living room",
          "kitchen",
          "garage"
        ]
      },
      "see_also": {
        "topic": "Contraction of There is (There's)",
        "rules": "There's a chair in the room. Note: There are is not contracted as There're in formal English."
      }
    },
