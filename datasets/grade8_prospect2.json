          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "Talking about Free Time & Verbs of Preference (like + V-ing)",
        "rules": [
          {
            "structure": "What do you do in your free time?",
            "formula": "In my free time, I + verb phrase",
            "examples": [
              "What do you do in your free time? I read books.",
              "What is your hobby? My hobby is playing chess."
            ]
          },
          {
            "structure": "Like + Gerund",
            "formula": "Subject + like / enjoy + V-ing",
            "examples": [
              "I like playing tennis.",
              "She enjoys listening to music."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "Hobby Survey & Personal Profile",
        "rules": [
          "Organize free-time activities into indoor hobbies (reading, drawing) and outdoor sports (cycling, swimming)."
        ]
      },
      "vocab_development": {
        "topic": "Hobby Gerunds (-ing forms)",
        "rules": "reading books, watching movies, riding a bike, walking in the park, playing computer games, surfing the net.",
        "examples": [
          "play tennis -> playing tennis",
          "read -> reading"
        ]
      },
      "see_also": {
        "topic": "Compound Word Stress in Sports",
        "rules": "'football, 'basketball, 'volleyball, 'table tennis."
      }
    }
