          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "Describing Rural Places & Farming Routines",
        "rules": [
          {
            "structure": "Are there ... in the village?",
            "formula": "Is there a river? / Are there many farms?",
            "examples": [
              "Is there a river in your village? Yes, there is.",
              "What do farmers grow? They grow wheat and rice."
            ]
          },
          {
            "structure": "Raising animals",
            "formula": "Villagers raise + livestock",
            "examples": [
              "They raise cattle and sheep in the green fields."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "Contrast Paragraph (City vs Village)",
        "rules": [
          "Describe peace, clean air, and nature in villages compared to busy traffic in cities."
        ]
      },
      "vocab_development": {
        "topic": "Farming, Crops, and Livestock",
        "rules": "farm, field, river, tree, flower, cattle, cow, sheep, horse, plow, wheat, rice, fruit, tractor.",
        "examples": [
          "raise cattle",
          "grow wheat"
        ]
      },
      "see_also": {
        "topic": "Pronunciation of Vowel Sounds in Rural Words",
        "rules": "Distinguish between /i:/ in field and /ɪ/ in village."
      }
    },
    {
      "lesson_num": 7,
      "title": "My Hobbies",
      "theme": "Free time activities, sports, reading, hobbies",
      "allowed_grammar": {
        "tenses": [
          "simple_present"
        ],
        "structures": [
          "what_do_you_do_in_free_time",
