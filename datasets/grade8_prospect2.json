  "lessons": [
    {
      "lesson_num": 1,
      "title": "My Nationality",
      "theme": "Countries, nationalities, languages",
      "allowed_grammar": {
        "tenses": [
          "simple_present_be"
        ],
        "structures": [
          "where_are_you_from",
          "nationality_adjectives",
          "are_you_from_questions"
        ]
      },
      "forbidden_grammar": {
        "forbidden_tenses": [
          "simple_past",
          "future_will",
          "present_perfect"
        ],
        "forbidden_structures": [
          "passive_voice",
          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "Where are you from? & Nationalities",
        "rules": [
          {
            "structure": "Asking about origin",
            "formula": "Where are you from? -> I am from + Country",
            "examples": [
              "Where are you from? I am from Iran.",
              "Where is he from? He is from France."
            ]
          },
          {
            "structure": "Nationality adjectives",
            "formula": "Subject + be + Nationality",
            "examples": [
              "Are you Iranian? Yes, I am.",
              "Is she French? No, she is Spanish."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "Capitalization of Countries and Nationalities",
        "rules": [
          "Names of countries, nationalities, and languages are always capitalized (Iran, Iranian, Persian, English, France, French)."
        ]
      },
      "vocab_development": {
        "topic": "Country to Nationality Suffixes (-ian, -ish, -ese)",
        "rules": "Iran -> Iranian, Spain -> Spanish, China -> Chinese, Japan -> Japanese, England -> English.",
        "examples": [
          "Iran -> Iranian",
          "Spain -> Spanish"
        ]
      },
      "see_also": {
        "topic": "Pronunciation of Nationality Endings",
        "rules": "Notice stress shift: 'China vs Chi'nese; 'Japan vs Japa'nese."
      }
    },
    {
      "lesson_num": 2,
      "title": "My Week",
      "theme": "Weekly schedule, days, routine activities",
      "allowed_grammar": {
        "tenses": [
          "simple_present_action"
        ],
        "structures": [
          "what_do_you_do_on_days",
          "do_does_questions",
          "frequency_adverbs_every_on"
        ]
      },
      "forbidden_grammar": {
        "forbidden_tenses": [
          "simple_past",
          "future_will",
          "present_perfect"
        ],
        "forbidden_structures": [
          "passive_voice",
          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "Simple Present (do / does) & Routine Actions",
        "rules": [
          {
            "structure": "Simple Present Questions with do/does",
            "formula": "Do you / Does he + base verb?",
            "examples": [
              "Do you go to school on Saturdays? Yes, I do.",
              "Does your brother play football on weekends? No, he doesn't."
            ]
          },
          {
            "structure": "Preposition 'on' with days",
            "formula": "on + day(s) of week",
            "examples": [
              "on Monday morning",
              "on Friday afternoon"
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "Third Person Singular -s and -es Spelling Rules",
        "rules": [
          "Add -s for most verbs (reads, plays, listens).",
          "Add -es after -ch, -sh, -s, -x, -o (watches, washes, goes, does).",
          "Consonant + y changes to -ies (studies, copies)."
        ]
      },
      "vocab_development": {
        "topic": "Weekday Routines and Activities",
        "rules": "go to school, study English, visit relatives, play sports, help parents, stay home.",
        "examples": [
          "go to the gym",
          "visit grandparents"
        ]
      },
      "see_also": {
        "topic": "Pronunciation of Third Person -s/-es",
        "rules": "/s/ after voiceless stops (helps, writes), /z/ after voiced (plays, studies), /iz/ after sibilants (watches, washes)."
      }
    },
    {
      "lesson_num": 3,
      "title": "My Abilities",
      "theme": "Talents, sports, can / can't",
      "allowed_grammar": {
        "tenses": [
          "simple_present"
        ],
        "structures": [
          "modal_can_ability",
          "can_you_questions",
          "short_answers_can"
        ]
      },
      "forbidden_grammar": {
        "forbidden_tenses": [
          "simple_past",
          "future_will",
          "present_perfect"
        ],
        "forbidden_structures": [
          "passive_voice",
          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "Modal Auxiliary Can / Can't for Abilities",
        "rules": [
          {
            "structure": "Asking about ability",
            "formula": "Can you / he / she + base verb?",
            "examples": [
              "Can you swim? Yes, I can.",
              "Can he drive a car? No, he can't."
            ]
          },
          {
            "structure": "Expressing talents",
            "formula": "I can + base verb + very well",
            "examples": [
              "I can speak English well.",
              "She can draw beautiful pictures."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "Listing Abilities with 'and' and 'but'",
        "rules": [
          "Use 'and' to connect similar abilities: 'I can swim and play football.'",
          "Use 'but' to contrast abilities: 'I can ride a bicycle, but I can't drive a car.'"
        ]
      },
      "vocab_development": {
        "topic": "Action Verbs & Sports Talents",
        "rules": "swim, ride a bicycle, play chess, cook food, recite the Holy Quran, make a cake, paint pictures.",
        "examples": [
          "ride a bike",
          "play chess"
        ]
      },
      "see_also": {
        "topic": "Pronunciation of can /kən/ vs can't /kænt/",
        "rules": "'Can' in statements is typically unstressed /kən/, whereas 'can't' is stressed with a clear open vowel /kænt/."
      }
    },
    {
      "lesson_num": 4,
      "title": "My Health",
      "theme": "Health problems, illnesses, advice with should",
      "allowed_grammar": {
        "tenses": [
          "simple_present"
        ],
        "structures": [
          "what_is_the_matter",
          "have_a_health_problem",
          "giving_advice_with_should"
        ]
      },
      "forbidden_grammar": {
        "forbidden_tenses": [
          "simple_past",
          "future_will",
          "present_perfect"
        ],
        "forbidden_structures": [
          "passive_voice",
          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "Health Complaints (have a ...) & Giving Advice with Should",
        "rules": [
          {
            "structure": "Asking what is wrong",
            "formula": "What is the matter? / What's wrong?",
            "examples": [
              "What is the matter? I have a headache.",
              "What's wrong with Ali? He has a sore throat."
            ]
          },
          {
            "structure": "Giving health advice",
            "formula": "You should / shouldn't + base verb",
            "examples": [
              "You should see a doctor.",
              "You shouldn't drink cold water."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "Doctor-Patient Advice Notes",
        "rules": [
          "Use the modal 'should' for recommendations: 'You should rest in bed.'",
          "Compound health nouns are written as one word (headache, toothache, stomachache) or two words (sore throat, runny nose)."
        ]
      },
      "vocab_development": {
        "topic": "Common Ailments and Treatments",
        "rules": "headache, toothache, stomachache, earache, sore throat, cough, fever, rest, take medicine, see a doctor.",
        "examples": [
          "have a headache",
          "take medicine"
        ]
      },
      "see_also": {
        "topic": "Silent 'l' in should and shouldn't",
        "rules": "The letter 'l' in should /ʃʊd/ is completely silent."
      }
    },
    {
      "lesson_num": 5,
      "title": "My City",
      "theme": "City places, weather, location",
      "allowed_grammar": {
        "tenses": [
          "simple_present_be"
        ],
        "structures": [
          "where_is_location",
          "what_is_it_famous_for",
          "weather_adjectives"
        ]
      },
      "forbidden_grammar": {
        "forbidden_tenses": [
          "simple_past",
          "future_will",
          "present_perfect"
        ],
        "forbidden_structures": [
          "passive_voice",
          "conditionals"
        ]
      },
      "grammar_details": {
        "focus": "Geographical Locations & Describing Cities",
        "rules": [
          {
            "structure": "Asking about location",
            "formula": "Where is + City? -> It is in the north / south / center of Iran.",
            "examples": [
              "Where is Isfahan? It is in the center of Iran.",
              "Where is Rasht? It is in the north."
            ]
          },
          {
            "structure": "What is it famous for?",
            "formula": "It is famous for + noun / V-ing",
            "examples": [
              "Shiraz is famous for Hafez tomb and beautiful gardens.",
              "Tabriz is famous for historic bazaars."
            ]
          }
        ]
      },
      "writing_skills": {
        "topic": "City Guide Descriptions",
        "rules": [
          "Capitalize cardinal directions when naming specific regions (North of Iran, West of Iran).",
          "Use commas when listing city attractions."
        ]
      },
      "vocab_development": {
        "topic": "Points of the Compass & City Facilities",
        "rules": "north, south, east, west, center. Facilities: mosque, museum, stadium, library, airport, shrine, bridge.",
        "examples": [
          "in the north",
          "famous for"
        ]
      },
      "see_also": {
        "topic": "Adjective Weather Forms (sun -> sunny, rain -> rainy)",
        "rules": "Add suffix -y to make weather adjectives: wind -> windy, cloud -> cloudy, rain -> rainy."
      }
    },
